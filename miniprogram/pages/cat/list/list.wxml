<view class="page" wx:if="{{ready}}">
  <view class="hero">
    <view class="hero-kicker">猫档</view>
    <view class="hero-title">校园猫档</view>
    <view class="hero-sub">健康猫看所属点位的投喂；需要特别照料的猫看单猫记录。</view>
  </view>
  <view class="card" wx:if="{{isAdmin}}">
    <view class="row" bindtap="toggleNewCatForm">
      <view class="card-title">新增猫档 · 仅管理员可见</view>
      <view class="pill">{{showNewCatForm ? '收起' : '打开'}}</view>
    </view>
    <block wx:if="{{showNewCatForm}}">
    <input class="input mt12" placeholder="名字或临时称呼" value="{{newCat.name}}" bindinput="onNewCatName" />
    <view class="chip-wrap mt12">
      <view class="chip {{newCat.gender === item.id ? 'on' : ''}}" wx:for="{{genders}}" wx:key="id" data-id="{{item.id}}" bindtap="pickNewCatGender">{{item.name}}</view>
    </view>
    <view class="chip-wrap mt12">
      <view class="chip {{newCat.siteId === '' ? 'on' : ''}}" data-id="" bindtap="pickNewCatSite">位置待确认</view>
      <view class="chip {{newCat.siteId === item._id ? 'on' : ''}}" wx:for="{{siteOptions}}" wx:key="_id" data-id="{{item._id}}" bindtap="pickNewCatSite">{{item.name}}</view>
    </view>
    <view class="row mt12">
      <view>身份待核对</view>
      <switch checked="{{newCat.provisional}}" bindchange="toggleNewCatProvisional" color="#3f6f52" />
    </view>
    <view class="btn" bindtap="addCat">保存新猫档</view>
    </block>
  </view>
  <view class="chip-wrap">
    <view class="chip {{campusStatus === item.id ? 'on' : ''}}" wx:for="{{filters}}" wx:key="id" data-id="{{item.id}}" bindtap="pickFilter">{{item.name}}</view>
  </view>
  <view class="empty" wx:if="{{!cats.length}}">这一类暂时没有猫。</view>
  <view class="card" wx:for="{{cats}}" wx:key="_id" data-id="{{item._id}}" bindtap="openCat">
    <view class="row">
      <image class="photo" wx:if="{{item.photoFileIds[0]}}" src="{{item.photoFileIds[0]}}" mode="aspectFill" />
      <view class="row-main">
        <view class="card-title">{{item.name}}</view>
        <view class="tiny mt8">{{item.dietLabel}}</view>
        <view class="tiny" wx:if="{{item.observationText}}">最近动态：{{item.observationText}}</view>
      </view>
      <view class="pill {{item.campusClass}}">{{item.campusText}}</view>
      <view class="pill warn" wx:if="{{item.provisional}}">待核对</view>
      <view class="pill warn" wx:if="{{item.needsIndividualCare}}">单猫追踪</view>
    </view>
  </view>
</view>
