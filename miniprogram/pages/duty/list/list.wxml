<view class="page has-tab" wx:if="{{ready}}">
  <view class="hero">
    <view class="hero-kicker">任务</view>
    <view class="hero-title">任务列表</view>
    <view class="hero-sub">{{heroSub}}</view>
  </view>

  <view class="card review-alert" wx:if="{{isAdmin && pendingMembers > 0}}" bindtap="goReviewMembers">
    <view class="row">
      <view class="card-title">待审核成员 · 仅管理员可见</view>
      <view class="pill warn">{{pendingMembers}} 人，去审批</view>
    </view>
  </view>

  <view class="card" wx:if="{{isAdmin}}" bindtap="goPublish">
    <view class="row">
      <view class="card-title">发布任务 · 仅管理员可见</view>
      <view class="pill">打开</view>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="toggleFilters">
      <view class="card-title">{{scopeId || siteId ? '筛选任务（已筛选）' : '筛选任务（可选）'}}</view>
      <view class="pill">{{showFilters ? '收起' : '打开'}}</view>
    </view>
    <block wx:if="{{showFilters}}">
    <view class="tiny mt8">频率</view>
    <view class="chip-wrap mt8">
      <view class="chip {{scopeId === '' ? 'on' : ''}}" data-id="" bindtap="pickScope">全部</view>
      <view class="chip {{scopeId === 'once' ? 'on' : ''}}" data-id="once" bindtap="pickScope">单次</view>
      <view class="chip {{scopeId === 'daily' ? 'on' : ''}}" data-id="daily" bindtap="pickScope">每日</view>
      <view class="chip {{scopeId === 'weekly' ? 'on' : ''}}" data-id="weekly" bindtap="pickScope">每周</view>
    </view>
    <view class="tiny mt16">地点</view>
    <view class="chip-wrap mt8">
      <view class="chip {{siteId === '' ? 'on' : ''}}" data-id="" bindtap="pickSite">全部</view>
      <view class="chip {{siteId === 'general' ? 'on' : ''}}" data-id="general" bindtap="pickSite">不限地点</view>
      <view class="chip {{siteId === 'move_board' ? 'on' : ''}}" data-id="move_board" bindtap="pickSite">搬运</view>
      <view class="chip {{siteId === item._id ? 'on' : ''}}" wx:for="{{sites}}" wx:key="_id" data-id="{{item._id}}" bindtap="pickSite">{{item.name}}</view>
    </view>
    </block>
  </view>

  <view class="empty" wx:if="{{!groups.length}}">这里暂时没有任务。</view>
  <view class="card" wx:for="{{groups}}" wx:key="siteId">
    <view class="card-title">{{item.siteName}}</view>
    <view class="empty" wx:if="{{!item.tasks.length}}">这个地点还没有任务。</view>
    <view class="list-item" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="_id" data-id="{{task._id}}" bindtap="openTask">
      <view class="row">
        <view class="row-main">
          <view>{{task.title}}</view>
          <view class="tiny">{{task.scopeShort}} · {{task.scopeHint}}</view>
          <view class="tiny" wx:if="{{task.status === 'claimed'}}">由 {{task.claimedByName}} 领取</view>
          <view class="tiny" wx:if="{{task.allowMultiple && task.participantNames}}">参与：{{task.participantNames}}</view>
        </view>
        <view>
          <view class="pill danger" wx:if="{{task.overdue}}">已超时</view>
          <view class="pill {{task.statusClass}}">{{task.statusText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card task-calendar">
    <view class="card-title">组织任务日历</view>
    <view class="tiny mt8">每天显示审核通过的任务数；多人完成同一任务，当天只算 1 项。</view>
    <view class="row mt16">
      <view class="chip" bindtap="prevCalendarMonth">上月</view>
      <view class="card-title">{{calendarMonth}}</view>
      <view class="chip" bindtap="nextCalendarMonth">下月</view>
    </view>
    <view class="task-calendar-grid mt12">
      <view class="task-calendar-head" wx:for="{{calendarWeek}}" wx:key="*this">{{item}}</view>
      <view class="task-calendar-day {{item.selected ? 'selected' : ''}}" wx:for="{{calendarDays}}" wx:key="key" data-date="{{item.blank ? '' : item.key}}" bindtap="pickCalendarDay">
        <view wx:if="{{!item.blank}}">{{item.day}}</view>
        <view class="task-calendar-count" wx:if="{{item.count}}">{{item.count}} 项</view>
      </view>
    </view>
    <view class="tiny mt12" wx:if="{{calendarLoading}}">正在加载完成记录…</view>
    <view class="card-title mt16">{{calendarSelectedDate}} · 已完成 {{calendarDayItems.length}} 项</view>
    <view class="empty" wx:if="{{!calendarLoading && !calendarDayItems.length}}">这一天还没有审核通过的任务。</view>
    <view class="list-item" wx:for="{{calendarDayItems}}" wx:key="taskId">
      <view>{{item.title}}</view>
      <view class="tiny">{{item.detailText}}</view>
    </view>
  </view>
</view>
<view class="page" wx:else>
  <view class="card">
    <view class="card-title">{{loginSlow ? '任务暂时没加载出来' : '正在加载任务…'}}</view>
    <view class="btn mt12" wx:if="{{loginSlow}}" bindtap="retryLogin">重试</view>
  </view>
</view>
