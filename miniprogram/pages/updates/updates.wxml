<view class="page">
  <view class="hero">
    <view class="hero-kicker">更新</view>
    <view class="hero-title">最近更新</view>
    <view class="hero-sub">体验版扫一次即可。之后打开就能看到改了什么、是按谁在群里说的改的。</view>
  </view>

  <view class="empty" wx:if="{{!items.length}}">还没有写入更新说明。</view>

  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="row">
      <view class="card-title">{{item.title}}</view>
      <view class="pill">{{item.dateKey}}</view>
    </view>
    <view class="muted mt12">{{item.body}}</view>
    <view class="tiny mt8" wx:if="{{item.whoText}}">{{item.whoText}}</view>
  </view>
</view>
