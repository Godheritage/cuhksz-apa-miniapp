<view class="page">
  <view class="hero">
    <view class="hero-kicker">仅管理员可见</view>
    <view class="hero-title">工作记录与 PF</view>
    <view class="hero-sub">按日期查看每件事，不排名。历史记录没有 PF 的地方留空，由管理员核实后填写。</view>
  </view>

  <view class="card">
    <view class="card-title">新增一条工作记录</view>
    <input class="input mt12" placeholder="做事人的名字" value="{{form.workerName}}" data-key="workerName" bindinput="onForm" />
    <picker mode="date" value="{{form.dateKey}}" bindchange="onDate">
      <view class="input mt12">日期：{{form.dateKey}}</view>
    </picker>
    <textarea class="textarea mt12" placeholder="做了什么" value="{{form.title}}" data-key="title" bindinput="onForm" />
    <input class="input mt12" type="digit" placeholder="PF 分数（可留空）" value="{{form.pf}}" data-key="pf" bindinput="onForm" />
    <view class="btn mt12" bindtap="addRecord">保存记录</view>
  </view>

  <view class="empty" wx:if="{{!records.length}}">还没有工作记录。</view>
  <view class="card" wx:for="{{records}}" wx:key="sourceKey">
    <view class="card-title">{{item.dateKey}} · {{item.workerName}}</view>
    <view class="muted mt8">{{item.title}}</view>
    <view class="tiny mt8">PF：{{item.pf === null ? '未填写' : item.pf}}</view>
    <view class="row mt12">
      <input class="input" type="digit" placeholder="填写或修改 PF" data-key="{{item.sourceKey}}" bindinput="onPf" />
      <view class="btn" data-key="{{item.sourceKey}}" bindtap="savePf">保存 PF</view>
    </view>
  </view>
</view>
