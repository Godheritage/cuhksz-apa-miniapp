<view class="page" wx:if="{{ready}}">
  <view class="hero">
    <view class="hero-kicker">使用指南</view>
    <view class="hero-title">{{title}}</view>
    <view class="hero-sub">{{lead}}</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:key="title">
    <view class="card-title">{{item.title}}</view>
    <view class="muted mt12">{{item.body}}</view>
  </view>

</view>
<view class="page" wx:else>
  <view class="card">
    <view class="card-title">{{error || '正在确认身份…'}}</view>
    <view class="btn mt12" wx:if="{{error}}" bindtap="reload">重试</view>
  </view>
</view>
