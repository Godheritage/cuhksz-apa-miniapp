<view class="page has-tab" wx:if="{{ready}}">
  <view class="hero">
    <view class="hero-kicker">每日执勤</view>
    <view class="hero-title">三处固定投喂点</view>
    <view class="hero-sub">示例寄养点、祥波、TA 每天早、午、晚、凌晨四班。选日期和班次打卡，照片可直接拍或选。</view>
  </view>

  <view class="card review-alert" wx:if="{{user.role === 'admin' && pendingMembers > 0}}" bindtap="goReviewMembers">
    <view class="row">
      <view class="card-title">待审核成员 · 仅管理员可见</view>
      <view class="pill warn">{{pendingMembers}} 人，去审批</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="chip" bindtap="prevMonth">上月</view>
      <view class="card-title">{{monthKey}}</view>
      <view class="chip" bindtap="nextMonth">下月</view>
    </view>
    <view class="duty-calendar mt12">
      <view class="calendar-head" wx:for="{{week}}" wx:key="*this">{{item}}</view>
      <view class="calendar-day {{item.selected ? 'selected' : ''}}" wx:for="{{days}}" wx:key="key" data-date="{{item.blank ? '' : item.key}}" bindtap="pickDay">
        <view wx:if="{{!item.blank}}">{{item.day}}</view>
        <view class="calendar-count" wx:if="{{item.count}}">{{item.count}}/{{totalSlots}}</view>
      </view>
    </view>
    <view class="tiny mt12">每天 12 个班位；同班多人打卡仍算 1 班。旧表排班不会自动算已打卡。</view>
  </view>

  <view class="card">
    <view class="card-title">{{selectedDate}} · 已打卡 {{doneSlots}}/{{totalSlots}} 班</view>
    <view class="tiny mt8">每班可多人参与。具体时段按协会排班；迟到也可补记，实际提交时间会保留。</view>
  </view>

  <view class="card" wx:for="{{cards}}" wx:for-item="site" wx:key="_id">
    <view class="card-title">{{site.name}}</view>
    <view class="list-item" wx:for="{{site.shifts}}" wx:for-item="shift" wx:key="id">
      <view class="row">
        <view>
          <view>{{shift.name}}</view>
          <view class="tiny" wx:if="{{shift.people}}">已打卡：{{shift.people}}</view>
        </view>
        <view class="row">
          <view class="pill {{shift.done ? 'on' : 'idle'}}">{{shift.done ? '已打卡' : '待打卡'}}</view>
          <view class="btn mini ghost" wx:if="{{!shift.mine}}" data-site-id="{{site._id}}" data-shift-id="{{shift.id}}" bindtap="pickSlot">我来打卡</view>
        </view>
      </view>
      <view class="checkin-row" wx:for="{{shift.logs}}" wx:for-item="log" wx:key="_id">
        <view class="row">
          <view>
            <view class="tiny">{{log.byName}} · {{log.timeText}}</view>
            <view class="tiny">{{log.fed ? '已投喂' : '未勾投喂'}} · {{log.watered ? '已添水' : '未勾添水'}}</view>
            <view class="tiny" wx:if="{{log.note}}">{{log.note}}</view>
          </view>
          <view class="btn mini plain" wx:if="{{log.canDelete}}" data-id="{{log._id}}" bindtap="deleteCheckin">删除</view>
        </view>
        <view class="photo-row mt8" wx:if="{{log.photoUrls.length}}">
          <image class="photo" wx:for="{{log.photoUrls}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{log.photoUrls}}" bindtap="previewPhoto" />
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{selectedSlot.siteId}}" id="checkin-form">
    <view class="row">
      <view class="card-title">{{selectedSlot.siteName}} · {{selectedSlot.shiftName}}打卡</view>
      <view class="chip" bindtap="closeForm">取消</view>
    </view>
    <view class="tiny mt8">{{selectedDate}} · 实际提交时间会自动记录</view>
    <view class="chip-wrap mt12">
      <view class="chip {{form.fed ? 'on' : ''}}" data-key="fed" bindtap="toggleFlag">{{form.fed ? '已投喂' : '投喂'}}</view>
      <view class="chip {{form.watered ? 'on' : ''}}" data-key="watered" bindtap="toggleFlag">{{form.watered ? '已添水' : '添水'}}</view>
    </view>
    <textarea class="textarea mt12" placeholder="现场情况、交接事项（可选）" value="{{form.note}}" bindinput="onNote" maxlength="200" />
    <view class="btn ghost mt12" bindtap="choosePhoto">拍照或选图（最多 3 张）</view>
    <view class="photo-row mt8" wx:if="{{form.photos.length}}">
      <view class="photo-cell" wx:for="{{form.photos}}" wx:key="*this">
        <image class="photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-urls="{{form.photos}}" bindtap="previewPhoto" />
        <view class="tiny remove-photo" data-index="{{index}}" bindtap="removePhoto">移除</view>
      </view>
    </view>
    <view class="btn" bindtap="save">{{saving ? '提交中…' : '确认打卡'}}</view>
  </view>
</view>
<view class="page has-tab" wx:else><view class="card">正在加载每日执勤…</view></view>
