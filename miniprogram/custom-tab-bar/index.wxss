.tab-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
  display: flex; box-sizing: border-box;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffdf8; border-top: 1rpx solid #e6dfd2;
}
.tab { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7a7368; }
.tab.active { color: #3f6f52; }
.label { font-size: 20rpx; line-height: 30rpx; }
.icon-img { display: block; width: 62rpx; height: 62rpx; margin-bottom: 2rpx; }
.badge { position: absolute; top: 5rpx; left: calc(50% + 12rpx); min-width: 24rpx; height: 24rpx; padding: 0 3rpx; border-radius: 16rpx; background: #b4413b; color: white; font-size: 16rpx; line-height: 24rpx; text-align: center; }
